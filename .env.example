# ==============================================================================
# CloudGuard - AWS Disaster Recovery Monitoring & Reporting Platform
# Configuration Environment Variables (.env.example)
# ==============================================================================

# Execution Mode: LOCAL or AWS
EXECUTION_MODE=LOCAL
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# ------------------------------------------------------------------------------
# Database Configurations (CloudGuard API vs Primary vs Isolated Sandbox)
# CRITICAL SAFETY RULE: RESTORE_TEST_DATABASE_URL must NEVER match PRIMARY_DATABASE_URL!
# ------------------------------------------------------------------------------
# CloudGuard System Metadata Database
DATABASE_URL=postgresql+psycopg2://cloudguard_admin:secure_prod_password@localhost:5432/cloudguard_db

# Primary Monitored Database (Used by demo-application)
PRIMARY_DATABASE_URL=postgresql+psycopg2://cloudguard_admin:secure_prod_password@localhost:5432/cloudguard_primary

# Isolated Sandbox Database for Disaster Recovery Verification (Segregated Port/DB)
RESTORE_TEST_DATABASE_URL=postgresql+psycopg2://cloudguard_admin:secure_prod_password@localhost:5433/cloudguard_isolated_test

# Local SQLite fallback for standalone zero-dependency testing / local developer mode
USE_SQLITE_FALLBACK=false
SQLITE_PRIMARY_PATH=./data/demo_app.db
SQLITE_RESTORE_TEST_PATH=./data/isolated_restore.db
SQLITE_CLOUDGUARD_PATH=./data/cloudguard.db

# ------------------------------------------------------------------------------
# Service URLs
# ------------------------------------------------------------------------------
DEMO_APP_API_URL=http://localhost:8001
CLOUDGUARD_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Disaster Recovery SLAs and Targets
# ------------------------------------------------------------------------------
TARGET_RTO_SECONDS=300
TARGET_RPO_MINUTES=60
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups

# ------------------------------------------------------------------------------
# AWS Mode Configurations (Required only when EXECUTION_MODE=AWS)
# Note: Never hardcode secrets. Use IAM Roles / Instance Profiles or AWS CLI config.
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_DR_BUCKET=cloudguard-dr-vault-us-east-1
AWS_BACKUP_VAULT_NAME=cloudguard-dr-backup-vault
AWS_RDS_SOURCE_INSTANCE_ID=cloudguard-primary-rds
AWS_RDS_RESTORE_TEST_SUBNET_GROUP=cloudguard-isolated-subnet-group
AWS_RDS_RESTORE_SECURITY_GROUP_ID=sg-0123456789abcdef0

# ------------------------------------------------------------------------------
# API & Security
# ------------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
